# Copy to `.env` and fill in real values. `.env` is gitignored.
# These two are PUBLIC client keys (gated by row-level security) and are the
# only credentials the app bundle needs. All third-party secrets
# (ANTHROPIC_API_KEY, REPLICATE_API_TOKEN, HF_TOKEN, ...) live server-side in
# Supabase function secrets and must NEVER be added here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
