# Miscellaneous
*.class
*.log
*.pyc
*.swp
# Every env file except the committed template. The wildcard matters: a bare
# `.env` entry does NOT match `.env.dev` or `.env.prod`.
.env*
!.env.example
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Ignore user clothing images but keep the folder so the pubspec asset resolves.
/assets/clothing/*
!/assets/clothing/.gitkeep

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. The keystore is unrecoverable — if it leaks anyone can ship
# an "update" to Cher, and if it is lost Play will never accept another update.
# Keep the .jks outside the repo entirely and back it up somewhere safe.
/android/key.properties
*.jks
*.keystore
